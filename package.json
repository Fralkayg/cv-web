  },
  "devDependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.23.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
